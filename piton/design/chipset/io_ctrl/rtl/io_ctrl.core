CAPI=3:
name: openpiton::io_ctrl:0.1
description: OpenPiton Chipset I/O Control Logic

filesets:
    rtl:
        files:
            - bram_map.v
            - ciop_iob.v
            - eth_top.v
            - fake_boot_ctrl.v
            - net_int_sync.v
            - uart_mux.v
            - uart_reader.v
            - uart_top.v
            - uart_writer.v
        file_type: verilogSource-2001

targets:
    default:
        filesets: [rtl]
    pickle:
        flow: sim
        filesets: [rtl]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001 -E]
    verify:
        flow: sim
        filesets: [rtl]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001]

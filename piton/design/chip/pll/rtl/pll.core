CAPI=3:
name: openpiton::pll:0.1
description: OpenPiton 

filesets:
    rtl:
        files:
            - clk_mux.v
            - clk_se_to_diff.v
            - pll_top.v
        file_type: verilogSource-2001

targets:
    default:
        filesets: [rtl]
    pickle:
        flow: sim
        filesets: [rtl]
        toplevel: [pll_top]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001 -E]
    verify:
        flow: sim
        filesets: [rtl]
        toplevel: [pll_top]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001]

CAPI=3:
name: openpiton::ifu_esl_htsm:0.1
description: ifu_esl_htsm testbench

filesets:
    rtl:
        files:
            - sparc_ifu_esl_htsm.v
        file_type: verilogSource-2001

targets:
    default:
        filesets: [rtl]
    pickle:
        flow: sim
        filesets: [rtl]
        toplevel: [sparc_ifu_esl_htsm]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001 -E]
    verify:
        flow: sim
        filesets: [rtl]
        toplevel: [sparc_ifu_esl_htsm]
        flow_options:
            tool: icarus
            iverilog_options: [-g 2001]
